calmare ao_k scena
scena:
	name "c0100" "c0100" "c0100_1"
	town town[4]
	bgm bgm[150]
	flags 8192
	item_use fn[0,255]
	unk 255 0

entry:
	pos (0, 0, -1000)
	unk1 0
	cam_from (0, 2500, 24000)
	cam_pers 500
	unk2 30
	cam_deg 45deg
	cam_limit 0deg 360deg
	cam_at (1100, 0, -3500)
	unk3 0
	unk4 0
	flags 0x0001
	town town[4]
	init fn[0,7]
	reinit fn[0,8]

fn[0]:
	TextStart self
	if flag[3385]:
		TextTalk self {
			我还想说好不容易才出来外面……
			那棵飘浮在空中的树到底是什么啊？{wait}
		}
		TextWait
		TextTalk self {
			应该不会掉下来砸到哪里吧？
			……我超担心的。{wait}
		}
		TextWait
	elif flag[3371]:
	elif flag[3089]:
		if !flag[0]:
			TextTalk self {
				以前发生过的意外，
				原因出于两大国的『暗斗』……{wait}
			}
			TextWait
			TextTalk self {
				意思是说，那是两国的间谍
				互相较劲的结果吗？{wait}
			}
			TextWait
			TextTalk self {
				……老实说，我没有想那么多，
				但如果是真的，实在是不可原谅。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				以前发生过的意外，
				原因出于两大国的『暗斗』……{wait}
			}
			TextWait
			TextTalk self {
				……老实说，我没有想那么多，
				但如果是真的，实在是不可原谅。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
			TextTalk self {
				有风声说，雇用那个武装集团的
				就是帝国政府……{wait}
			}
			TextWait
			TextTalk self {
				如果是的话，不知道对方
				什么时候会再次发动攻击。{wait}
			}
			TextWait
			TextTalk self {
				一想到这里，我就很担心……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				有风声说，雇用那个武装集团的
				就是帝国政府……{wait}
			}
			TextWait
			TextTalk self {
				一想到对方可能会再次发动攻击，
				我就很担心……{wait}
			}
			TextWait
	elif flag[2861]:
		TextTalk self {
			玛因兹的人们现在
			一定过得很辛苦吧……{wait}
		}
		TextWait
		TextTalk self {
			一大群手持武器的人
			突然闯进来，
			这画面光是用想的都觉得可怕……{wait}
		}
		TextWait
	elif flag[2848]:
		TextTalk self {
			今天妈妈拜托我帮忙跑腿。{wait}
		}
		TextWait
		TextTalk self {
			……因为屋顶漏水，
			要我赶快去买水桶。{wait}
		}
		TextWait
	elif flag[2837]:
		TextTalk self {
			居然出动了那么多救护车……
			好像发生了很严重的意外呢。{wait}
		}
		TextWait
	elif flag[2832]:
		TextTalk self {
			我真的想要一个人搬出来住吗？{wait}
		}
		TextWait
		TextTalk self {
			虽然很向往独立的生活，
			但家里只有自己一个人，
			感觉会很寂寞耶……{wait}
		}
		TextWait
	elif flag[2816]:
		if !flag[0]:
			TextTalk self {
				打工、打工……
				要稳定的话，应该就是去当服务生吧。{wait}
			}
			TextWait
			TextTalk self {
				不过，如果想赶快赚钱的话，
				去当公关小姐也行……{wait}
			}
			TextWait
			TextTalk self {
				……不行不行不行，
				我也真是的，到底在想什么啊？{wait}
			}
			TextWait
			TextTalk self {
				不管多好赚，我都是绝对
				没办法陪大叔喝酒的！{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				想一个人生活，就得打工才行……
				我适合怎样的工作呢？{wait}
			}
			TextWait
	elif flag[2573]:
		if !flag[0]:
			TextTalk self {
				如果要一个人住，我个人觉得
				住在西侧大道那边是首选……{wait}
			}
			TextWait
			TextTalk self {
				但考虑到房租和现实的因素，
				最后还是会落脚在东侧大道那边吧。{wait}
			}
			TextWait
			TextTalk self {
				旧市街虽然房租超便宜，
				但我很担心治安问题……{wait}
			}
			TextWait
			TextTalk self {
				话说回来，如果要搬出来住，
				得先找到打工才行。
				……唉……{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				如果要一个人住，我个人觉得
				住在西侧大道那边是首选……{wait}
			}
			TextWait
			TextTalk self {
				……话说回来，如果要搬出来住，
				得先找到打工才行。{wait}
			}
			TextWait
	elif flag[2568]:
		TextTalk self {
			哎呀呀，已经这么晚啦。{wait}
		}
		TextWait
		TextTalk self {
			我得快点回家
			帮妈妈的忙才行。{wait}
		}
		TextWait
	elif flag[2564]:
		TextTalk self {
			各国领导人来到克洛斯贝尔的
			过程其实很短耶。{wait}
		}
		TextWait
		TextTalk self {
			大家都坐在车子里，
			不太清楚谁是谁……
			但可以感受到ＶＩＰ的感觉。{wait}
		}
		TextWait
	elif flag[2560]:
		if !flag[0]:
			TextTalk self {
				毕竟明天开始就是通商会议，
				感觉气氛真的有点严肃呢。{wait}
			}
			TextWait
			TextTalk self {
				刚才我还被巡逻的警官叫住，
				这还是我这辈子第一次
				被警察盘问呢。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				虽然是第一次被警察盘问，
				但总觉得这样很失礼耶。{wait}
			}
			TextWait
			TextTalk self {
				不管是谁都不想大声说
				自己是在帮忙家务嘛……
				真是丢脸丢到家了。{wait}
			}
			TextWait
	elif flag[2369]:
		TextTalk self {
			我不想要因为下雨
			就整天待在家里。{wait}
		}
		TextWait
		TextTalk self {
			所以就撑着最喜欢的伞
			出来散步啰丅{wait}
		}
		TextWait
	elif flag[2353]:
		if flag[2437] && QuestFlagsGet quest[105] 0x10:
			TextTalk self {
				路上出现一大堆警车，
				吓我一跳。{wait}
			}
			TextWait
			TextTalk self {
				不过，感觉很有警察的气氛，
				好像有点帅呢。{wait}
			}
			TextWait
		elif !flag[0]:
			TextTalk self {
				讨厌，我爸为什么老是
				不穿衣服在家里乱晃啊？{wait}
			}
			TextWait
			TextTalk self {
				该说是都没顾虑到青春期的女儿吗……
				根本就是犯罪了吧。{wait}
			}
			TextWait
			TextTalk self {
				啊～好想搬出去一个人住喔～{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				啊～好想搬出去一个人住喔～{wait}
			}
			TextWait
			TextTalk self {
				嗯～哪里有
				好的房屋出租呢？{wait}
			}
			TextWait
	TextEnd self
	Return

fn[1]:
