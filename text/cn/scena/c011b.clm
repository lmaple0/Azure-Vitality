	TextStart null
	ED7_E3 10
	FadeOut 300ms 0x00000000 255
	FadeWait
	ED7_E3 5
	var[3] = 0
	while var[3] != 255:
		var[3] = ED7_E3 0
		switch var[3]:
			case 0:
				if flag[3089]:
					QuestList quest[148]
				elif flag[3074]:
					if QuestFlagsGet quest[134] 0x10:
						QuestList quest[142] quest[143] quest[144] quest[145] quest[146] quest[157] quest[138]
					else:
						QuestList quest[142] quest[143] quest[144] quest[145] quest[146] quest[138]
				elif flag[2861]:
					TextSetPos -1 -1 -1 -1
					TextSetName "自动广播"
					TextMessage null {
						{color 5}目前没有支援请求。{color 0}{wait}
					}
					TextWait
					TextClose 0
					TextSetPos -1 280 60 3
					_59
				elif flag[2848]:
					QuestList quest[139] quest[140] quest[136] quest[128] quest[131]
				elif flag[2832]:
					if QuestFlagsGet quest[130] 0x10:
						QuestList quest[133] quest[134] quest[135] quest[136] quest[128] quest[131]
					else:
						QuestList quest[133] quest[134] quest[136] quest[128] quest[131]
				elif flag[2816]:
					QuestList quest[128] quest[129] quest[130] quest[131]
				elif flag[2592]:
				elif flag[2573]:
					QuestList quest[121] quest[122] quest[123] quest[119] quest[113] quest[114]
				elif flag[2563]:
					QuestList quest[116] quest[117] quest[118] quest[119] quest[113] quest[114]
				elif flag[2560]:
					QuestList quest[111] quest[112] quest[113] quest[114]
				elif flag[2369]:
					if flag[2375]:
						QuestList quest[106] quest[107] quest[108] quest[109] quest[103]
					else:
						QuestList quest[106] quest[107] quest[108] quest[103]
				elif flag[2359]:
					QuestList quest[101] quest[102] quest[103]
				else:
					QuestList quest[101] quest[102] quest[103] quest[104]
				break
			case 1:
				SystemFlagsSet 0x40000000
				ED7_E3 7
				Sleep 500ms
				if system[4] >= 5:
					TextSetName "自动广播"
					TextMessage null {
						这里是克洛斯贝尔警察。{wait}
					}
					TextWait
					if ED7_E3 4:
						TextMessage null {
							我们将受理您的报告。{wait}
						}
						TextWait
						TextClose 0
						var[5] = system[47]
						ED7_E3 12
						TextSetName "自动广播"
						TextMessage null {
							已结束报告受理。
							辛苦了。{wait}
						}
						TextWait
					else:
						TextMessage null {
							没有可以报告的委托。{wait}
						}
