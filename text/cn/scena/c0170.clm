	TextMessage char[29] {
		#07103F虽然有点可惜，不过……
		但公务行程可是，
		万万不能迟到。{wait}
	}
	TextWait
	TextSetPos -1 0 -1 -1
	TextMessage char[28] {
		#07003F嗯，那当然。{wait}
	} {
		#07001F我就是为了
		那件事来到
		克洛斯贝尔的。{wait}
	}
	TextWait
	TextSetPos -1 230 -1 -1
	TextMessage char[29] {
		#07100F我们先回
