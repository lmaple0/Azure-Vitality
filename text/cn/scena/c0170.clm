fn[3]:
	if flag[3074]:
		LookPointFlagsSet look_point[1] 0x0001
	if !flag[3385] && flag[3371]:
		LookPointFlagsSet look_point[0] 0x0001
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
		SoundPlay sound[128] 1 50 0
	if !flag[3385] && flag[3370]:
		MapColor 0x00E6D2D2 0ms
		ED7_76_0 object[255] "hikari00_add" 1
		ED7_76_0 object[255] "hikari01_add" 1
	if system[0] == 102:
		ED7_76_1 object[255] "model5" 1
	else:
		ED7_76_0 object[255] "model5" 1
	LookPointFlagsSet look_point[9] 0x0001
	if QuestFlagsGet quest[115] 0x02 && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40 && flag[2723]:
		EntranceSetFunc entrance[0] fn[0,53]
		LookPointFlagsUnset look_point[9] 0x0001
	Return

fn[4]:
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}　　★　瑞琼食品丄备忘　★
		提供来店的客人口感清爽的
		铃莓果汁。{wait}
	}
	TextWait
	TextMessage null {
		{color 5}这里写着铃莓果汁的食谱。{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	if ItemHas item[2] 0:
		if !RecipeLearn 22:
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[17] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				记住了{color 2}『铃莓果汁』{color 0}的食谱。{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
	TextEnd null
	Return

fn[5]:
	Call fn[0,6]
	Return

fn[6]:
	TextStart char[0]
	if flag[3385]:
		TextTalk char[0] {
			不久前斯克特先生来露过脸了，
			看起来很有精神的样子，
			真是太好了。{wait}
		}
		TextWait
		TextTalk char[0] {
			毕竟他那么努力……
			我也得尽我所能
			好好努力才行！{wait}
		}
		TextWait
	elif flag[3371]:
		if !flag[3548]:
			Call fn[0,23]
		elif !flag[0]:
			TextTalk char[0] {
				幸好这个地方
				目前还不缺
				食材和日用品，不过……{wait}
			}
			TextWait
			TextTalk char[0] {
				如果这个状况持续得太久，
				反而让人担心有些家庭
				缺少这方面的库存呢。{wait}
			}
			TextWait
			TextTalk char[0] {
				说真的……政府到底
				在想些什么呢？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				说真的……政府到底
				在想些什么呢？{wait}
			}
			TextWait
			TextTalk char[0] {
				希望斯克特先生
				平安无事……{wait}
			}
			TextWait
	elif flag[3089]:
		if !flag[0]:
			TextTalk char[0] {
				辛西亚学姐在公民投票的隔天，
				就回到故乡雷米菲利亚了。{wait}
			}
			TextWait
			TextTalk char[0] {
				学姐应该也
				没预料到现在克洛斯贝尔
				会是这种情况……{wait}
			}
			TextWait
			TextTalk char[0] {
				她的家人好像
				从以前就很担心她的样子，
				能提早回国真是太好了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				辛西亚学姐跟我约好了，
				她一定还会再回到
				这间百货。{wait}
			}
			TextWait
			TextTalk char[0] {
				虽然很担心将来的事情……
				但我相信一定有天可以跟学姐
				相聚，总之现在要好好努力。{wait}
			}
			TextWait
	elif flag[3074]:
		if !flag[0]:
