fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (13800, 8000, 6200) 2000mm/s 0
		CharWalkToPos self (14520, 8000, 20050) 2000mm/s 0
		CharWalkToPos self (8730, 8000, 20460) 2000mm/s 0
		CharWalkToPos self (8730, 8000, 20460) 2000mm/s 0
		CharWalkToPos self (8530, 8000, 26610) 2000mm/s 0
		CharWalkToPos self (-14240, 8000, 26610) 2000mm/s 0
		CharWalkToPos self (-17130, 8000, 23430) 2000mm/s 0
		CharWalkToPos self (-17130, 8000, 7560) 2000mm/s 0
		CharWalkToPos self (-11380, 8000, 2990) 2000mm/s 0
		CharWalkToPos self (14040, 8000, 2490) 2000mm/s 0
	Return

fn[2]:
	if flag[3385]:
		CharFlagsSet char[1] 0x0080
		CharFlagsUnset char[26] 0x0080
		CharSetPos char[9] (-13470, 0, 6510) 135deg
		CharSetPos char[26] (-12670, 0, 5710) 315deg
	elif flag[3371]:
		CharSetPos char[10] (-17370, 30, 22740) 45deg
		CharFlagsSet char[1] 0x0080
		CharSetPos char[0] (-1360, 0, 9830) 270deg
		CharTurnTo char[9] 90deg 0deg/s
		CharFlagsSet char[11] 0x0080
		CharFlagsSet char[12] 0x0080
		CharFlagsSet char[13] 0x0080
		CharFlagsSet char[14] 0x0080
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharSetPos char[8] (8060, 8000, 2080) 90deg
		CharSetPos char[7] (9560, 8000, 2080) 270deg
	elif flag[3089]:
		CharFlagsSet char[1] 0x0080
		CharSetPos char[14] (-13640, 8029, 7380) 45deg
		CharFlagsSet char[5] 0x0010
		CharFlagsSet char[14] 0x0010
		CharSetPos char[13] (8020, 8000, 17270) 90deg
		CharSetPos char[12] (9070, 8000, 17290) 270deg
		ForkFunc char[12] fork[0] fn[0,0]
	elif flag[3074]:
		CharFlagsSet char[1] 0x0080
		CharSetPos char[14] (-13640, 8029, 7380) 45deg
		CharFlagsSet char[5] 0x0010
		CharFlagsSet char[14] 0x0010
	elif flag[2861]:
		CharSetPos char[14] (-13640, 8029, 7380) 45deg
		CharFlagsSet char[5] 0x0010
		CharFlagsSet char[14] 0x0010
	elif flag[2848]:
		CharSetPos char[14] (-13640, 8029, 7380) 45deg
		CharFlagsSet char[5] 0x0010
		CharFlagsSet char[14] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[18] 0x0080
	elif flag[2837]:
		CharFlagsUnset char[27] 0x0080
	elif flag[2832]:
		CharFlagsUnset char[25] 0x0080
	elif flag[2816]:
		CharFlagsSet char[10] 0x0080
	elif flag[2573]:
		CharFlagsUnset char[19] 0x0080
		CharFlagsSet char[19] 0x0010
		CharFlagsUnset char[20] 0x0080
		if !flag[16]:
			CharFlagsSet char[20] 0x0010
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[23] 0x0080
		CharSetChipBase char[22] chip[19]
		CharSetChipPattern char[22] 0
		ForkQuit char[22] fork[0]
		CharFlags2Set char[22] 0x0004
		CharSetChipBase char[23] chip[20]
		CharSetChipPattern char[23] 0
		ForkQuit char[23] fork[0]
		CharFlags2Set char[23] 0x0004
		CharFlagsSet char[11] 0x0080
		CharFlagsUnset char[24] 0x0080
	elif flag[2568]:
		CharSetPos char[13] (8020, 8000, 17270) 90deg
		CharSetPos char[12] (9070, 8000, 17290) 270deg
		ForkFunc char[12] fork[0] fn[0,0]
		CharFlagsSet char[12] 0x0010
		CharFlagsSet char[11] 0x0080
	elif flag[2564]:
		CharFlagsUnset char[18] 0x0080
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[23] 0x0080
		CharSetChipBase char[22] chip[19]
		CharSetChipPattern char[22] 0
		ForkQuit char[22] fork[0]
		CharFlags2Set char[22] 0x0004
		CharSetChipBase char[23] chip[20]
		CharSetChipPattern char[23] 0
		ForkQuit char[23] fork[0]
		CharFlags2Set char[23] 0x0004
		CharFlagsUnset char[24] 0x0080
	elif flag[2560]:
		CharFlagsSet char[10] 0x0080
		CharFlagsUnset char[15] 0x0080
		CharSetChipBase char[15] chip[13]
		CharSetChipPattern char[15] 0
		ForkQuit char[15] fork[0]
		CharFlags2Set char[15] 0x0004
		CharFlagsUnset char[16] 0x0080
		CharFlagsUnset char[17] 0x0080
		if !flag[13]:
			CharFlagsSet char[15] 0x0010
		CharFlagsSet char[16] 0x0010
		CharFlagsSet char[17] 0x0010
		CharFlagsUnset char[22] 0x0080
		CharFlagsUnset char[23] 0x0080
		CharSetChipBase char[22] chip[19]
		CharSetChipPattern char[22] 0
		ForkQuit char[22] fork[0]
		CharFlags2Set char[22] 0x0004
		CharSetChipBase char[23] chip[20]
		CharSetChipPattern char[23] 0
		ForkQuit char[23] fork[0]
		CharFlags2Set char[23] 0x0004
		CharFlagsUnset char[24] 0x0080
	elif flag[2369]:
		CharSetPos char[10] (-17370, 30, 22740) 45deg
		CharFlagsSet char[6] 0x0010
		CharFlagsSet char[10] 0x0010
		CharFlagsUnset char[8] 0x0080
		CharFlagsUnset char[7] 0x0080
		CharFlagsUnset char[21] 0x0080
		if !QuestFlagsGet quest[110] 0x10:
			CharFlagsUnset char[20] 0x0080
			CharSetPos char[20] (-15840, 0, 15980) 0deg
			CharFlagsSet char[20] 0x0010
	elif flag[2353]:
		CharFlagsSet char[10] 0x0080
		CharFlagsUnset char[21] 0x0080
	if flag[272]:
		FlagUnset flag[272]
		SystemFlagsSet 0x10000000
		Event fn[0,51]
	elif flag[273]:
		FlagUnset flag[273]
		Event fn[0,54]
