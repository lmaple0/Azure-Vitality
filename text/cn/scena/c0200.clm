		EventEnd 4
		Return
	if flag[2861] && !flag[3074]:
		EventBegin 1
		TextTalk name[0] {
			#00001F现在最要紧的事情，
			就是要追上兰迪──
			这可不是走岔路的时候。{wait}
		}
		TextWait
		CharSetPos field_party[0] (-34230, 0, 4210) 90deg
		EventEnd 4
		Return
	if flag[3089] && !flag[3100]:
