			#00001F现在不是到市外的时候。
			还是先回头吧。{wait}
		}
		TextWait
		CharSetPos field_party[0] (-34230, 0, 4210) 90deg
		EventEnd 4
		Return
	if flag[3371] && !flag[3385]:
		EventBegin 1
		TextTalk name[0] {
			#00001F都到这地步了，
			可不能随便离开市内。{wait}
		} {
