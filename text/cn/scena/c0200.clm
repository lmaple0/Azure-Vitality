fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (7000, -300, 610) 6000mm/s 0
		CharWalkToPos self (7000, 0, -9140) 6000mm/s 0
		CharWalkToPos self (-1000, -10, -9140) 6000mm/s 0
		CharWalkToPos self (-1000, 0, 610) 6000mm/s 0
	Return

fn[2]:
	while 1:
		CharWalkToPos self (-10000, 0, 5750) 800mm/s 0
		CharWalkToPos self (-10000, 0, 2280) 800mm/s 0
		CharWalkToPos self (-27380, 0, 2280) 800mm/s 0
		CharWalkToPos self (-27380, 0, 5750) 800mm/s 0
	Return

fn[3]:
	while 1:
		CharIdle self (-28870, null, 2540) (-21090, null, 6380) 1000mm/s
		Sleep 300ms
	Return

fn[4]:
	while 1:
		var[2] = random % 100
		if var[2] < 20:
			CharWalkToPos2 self (4100, 0, -3060) 300mm/s 0
		elif var[2] < 40:
			CharWalkToPos2 self (4100, 0, -3160) 300mm/s 0
		elif var[2] < 60:
			CharWalkToPos2 self (4100, 0, -3260) 300mm/s 0
		elif var[2] < 80:
			CharWalkToPos2 self (4100, 0, -3360) 300mm/s 0
		else:
			CharWalkToPos2 self (4100, 0, -3460) 300mm/s 0
		Sleep 500ms
	Return

