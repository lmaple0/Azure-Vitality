			Call fn[0,28]
			Return
	elif QuestFlagsGet quest[107] 0x02 && !QuestFlagsGet quest[107] 0x10 && !QuestFlagsGet quest[107] 0x40 && !flag[2451]:
		Call fn[0,26]
		Return
	TextStart char[0]
	var[0] = 99
	while var[0] == 99:
		FadeOut 300ms 0x00000000 100
		Menu menu[0] -1 -1 1
			"交谈" // 0
			"买东西" // 1
			"放弃" // 2
		MenuWait var[0]
		if var[0] != 1:
			MenuClose menu[0]
			FadeIn 300ms 0x00000000
			FadeWait
		if var[0] == 1:
			if flag[3385]:
				ShopOpen shop[204]
			elif flag[3074]:
				ShopOpen shop[203]
			elif flag[2816]:
				ShopOpen shop[202]
			elif flag[2560]:
				ShopOpen shop[201]
			else:
				ShopOpen shop[200]
			var[0] = 99
		elif var[0] != 0:
		elif var[0] == 0:
			var[0] = 99
			Call fn[0,7]
	TextEnd char[0]
	Return

fn[7]:
