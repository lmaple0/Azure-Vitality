fn[8]:
	TextStart self
	if flag[3385]:
		TextTalk self {
			其实，刚刚伊莉雅
			用导力通讯给团员们
			送来声援的消息了。{wait}
		}
		TextWait
		TextTalk self {
			该怎么说呢？伊莉雅真的
			很努力，让我们勇气百倍喔。{wait}
		}
		TextWait
	elif flag[3371]:
	elif flag[3089]:
	elif flag[3074]:
	elif flag[2861]:
	elif flag[2848]:
	elif flag[2837]:
	elif flag[2832]:
	elif flag[2816]:
	elif flag[2573]:
		if !flag[2653]:
			Call fn[0,9]
		elif !flag[0]:
			TextTalk char[3] {
				唔……我也真是的。
				激动过度，完全没注意到你们啊。{wait}
			}
			TextWait
			TextTalk char[3] {
				不过，还好是你们。{wait}
			}
			TextWait
			TextTalk char[3] {
				要是被其他团员看到的话……
				伊莉雅肯定会赏我一百大板。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[1] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[2] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Emote field_party[3] 0mm 2000mm 16 19 250ms 1
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			FlagSet flag[0]
		else:
			TextTalk self {
				唔……我也真是的。
				激动过度，完全没注意到你们啊。{wait}
			}
			TextWait
			TextTalk self {
				要是被其他团员看到的话……
				伊莉雅肯定会赏我一百大板。{wait}
			}
			TextWait
	elif flag[2564]:
	elif flag[2560]:
	elif flag[2369]:
	elif flag[2353]:
	TextEnd self
	Return

fn[9]:
	_Char4A char[3] 255
	_Char4A char[0] 255
	TextTalk char[0] {
		上次提过的服装设计图，
		我已经画出来了……{wait}
	}
	TextWait
	TextTalk char[0] {
		这样看起来如何呢？{wait}
	}
	TextWait
	TextTalk char[3] {
		嗯！挺棒的啊！
		照这个方向去做，
		基本上就没问题了。{wait}
	}
	TextWait
	TextTalk char[3] {
		我会拿去给伊莉雅看，
		整合好我们的意见之后，
		再进行讨论吧。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00005F（新服装的设计图……？）{wait}
	}
	TextWait
	TextTalk name[1] {
		#00100F（……挺有意思的嘛。）{wait}
	}
	TextWait
	Emote char[0] 0mm 2000mm 38 38 250ms 1
	Sleep 1000ms
	CharTurnToChar char[0] field_party[0] 0deg/s
	TextTalk char[0] {
		哎呀呀，你们是……？{wait}
	}
	TextWait
	TextTalk char[3] {
		唔，是谁啊……（迅速收起来）{wait}
	}
	TextWait
	CharTurnToChar char[3] field_party[0] 0deg/s
	TextTalk char[3] {
		哎呀，你们是……
		……你们听到刚刚的话了吗？{wait}
	}
	TextWait
	if system[10] == 0:
		TextTalk name[0] {
			#00006F呃……
			不好意思。{wait}
		}
		TextWait
	elif system[10] == 1:
		TextTalk name[1] {
			#00106F那个……不好意思。{wait}
		}
		TextWait
