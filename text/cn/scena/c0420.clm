fn[6]:
	TextStart self
	if flag[3371]:
		if !flag[3709]:
			TextTalk self {
				如何？大家都很拼命吧？{wait}
			}
			TextWait
			TextTalk self {
				大家现在为了
				尽早让公演继续举办下去，
				正全心全力努力着。{wait}
			}
			TextWait
			TextTalk self {
				听说伊莉雅也
				已经醒过来了……
				我们可不能辜负她的期望。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F（……看来剧团的成员们
				　连莉夏目前人在哪里
				　都不知道吧。）{wait}
			} {
				（虽然很想让他们
				　见上一面，不过……）{wait}
			}
			TextWait
		else:
			TextTalk self {
				我们就跟往常一样，
				在这里努力钻研表演，
				并继续等候她。{wait}
			}
			TextWait
			TextTalk self {
				罗伊德、还有各位，
				莉夏的事情
				就拜托你们了。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00000F好，我明白了。{wait}
			}
			TextWait
			if PartyPosition name[5] > -1:
				TextTalk name[5] {
					#10700F团长……
					谢谢您。{wait}
				}
				TextWait
	elif flag[3089]:
		TextTalk self {
			大家真的
			都做得很好。{wait}
		}
		TextWait
		TextTalk self {
			伊莉雅、莉夏……
			我们一定会等你们回来的。{wait}
		}
		TextWait
	elif flag[3074]:
		if !flag[3176]:
			Emote char[3] 0mm 2000mm 38 38 250ms 1
			Sleep 1000ms
			CharTurnToChar self name[0] 0deg/s
			TextTalk char[3] {
				喔，是罗伊德啊……{wait}
			}
			TextWait
			TextTalk char[3] {
				…………{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F团长……{wait}
			}
			TextWait
			TextTalk char[3] {
				啊……抱歉。{wait}
			}
			TextWait
			TextTalk char[3] {
				我左思右想之，
				还是觉得很不安。{wait}
			}
			TextWait
			TextTalk char[3] {
				伊莉雅是个坚强的人。
				我相信她一定能清醒过来，
				不过……{wait}
			}
			TextWait
			TextTalk name[1] {
				#00108F团长先生……{wait}
			}
			TextWait
			TextTalk char[3] {
				呼，不过，我再怎么担心
				也改变不了什么。{wait}
			}
			TextWait
			TextTalk char[3] {
				我……我也得
				再坚强一点才行。{wait}
			}
			TextWait
			CharFlagsUnset char[3] 0x0010
			FlagSet flag[3176]
		else:
			TextTalk self {
				呼，我也差不多
				该振作起来了。{wait}
			}
			TextWait
			TextTalk self {
				老是这样沮丧的话，
				伊莉雅一定会骂我吧。{wait}
			}
			TextWait
	elif flag[2861]:
		TextTalk self {
			罗伊德，还有各位，不好意思啊。{wait}
		}
		TextWait
		TextTalk self {
			正式表演就快开始了。
			大家都想好好利用时间，
			准备到最后一刻。{wait}
		}
		TextWait
	elif flag[2848]:
	elif flag[2837]:
	elif flag[2832]:
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2564]:
	elif flag[2560]:
		if !flag[2654]:
			Call fn[0,8]
		else:
			TextTalk self {
				伊莉雅真是
				太可靠啦。{wait}
			}
			TextWait
			TextTalk self {
				看这情况，她一定可以让
				明天的表演进行得很顺利。{wait}
			}
			TextWait
	elif flag[2369]:
	elif flag[2353]:
		if !flag[0]:
			Call fn[0,7]
