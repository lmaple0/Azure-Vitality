	TextTalk name[0] {
		#12P#00011F没、没办法认同……{wait}
	}
	TextWait
	TextTalk char[0] {
		#5P#01700F当时周围的观众和我父母
		的确都赞不绝口，所以
		表演肯定是很精彩的，不过……{wait}
	} {
		#01703F该怎么说呢？如果是我的话，
		我一定能演得更棒！
		我当时是这么想的吧。{wait}
	} {
		#01702F呵呵，不过说来奇怪，
