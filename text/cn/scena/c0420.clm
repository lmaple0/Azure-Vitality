	TextTalk char[0] {
		#5P#01704F嗯，二楼的座位可以把
		整个舞台都看得很清楚。{wait}
	} {
		#01702F哎呀，话说回来，
		年轻女孩们努力的模样，
		真是令人百看不厌呢～{wait}
	} {
		这么看着看着，都让我
		回忆起自己刚出道的时候了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#12P#00005F伊莉雅小姐刚出道的时候……{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#00302F哈哈，好像有点难以想像啊。{wait}
	}
	TextWait
	TextTalk name[4] {
		#6P#10302F呵呵，有机会的话，我还真想
		知道当时发生了什么事。{wait}
	}
	TextWait
	CharTurnToChar char[0] name[1] 500deg/s
	TextTalk char[0] {
		#5P#01700F呵呵，要我说也行，不过……
		那并不是什么有趣的事喔！{wait}
	}
	TextWait
	TextTalk name[8] {
		#12P#10109F哇哇！请务必告诉我们！！{wait}
	} {
		#10100F我记得您刚出道时，
		杂志就以『万众瞩目的重量级新人』
		为标题大幅报道过吧。{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#00205F原来如此，一出道就那么红了。{wait}
	} {
		#00202F顺道请教一下……
		您当初之所以会想当演员，
		有什么特别的原因吗？{wait}
	}
	TextWait
	TextTalk char[0] {
		#5P#01703F嗯，我想想。{wait}
	} {
		#01700F在我小的时候就看过
		彩虹剧团的表演，
		这大概就是契机吧。{wait}
	}
	TextWait
	TextTalk name[3] {
		#12P#00300F原来如此，所以心生憧憬──
		差不多是这样吧？{wait}
	}
	TextWait
	TextTalk char[0] {
		#5P#01703F嗯，有点不太对。{wait}
	} {
		#01700F当时演员们的演技
		以及舞台装置的效果都已经
		很棒了，不过……{wait}
	} {
		#01706F看完表演后，我还是
		觉得少了什么东西，所以一直
		没办法认同他们。{wait}
	}
