fn[16]:
	while 1:
		var[2] = random % 100
		if var[2] < 5:
			CharSetChipPattern char[19] 1
			Sleep 4000ms
			CharSetChipPattern char[19] 0
		elif var[2] < 15:
			CharSetChipPattern char[19] 2
			Sleep 4000ms
			CharSetChipPattern char[19] 0
		Sleep 500ms
	Return

