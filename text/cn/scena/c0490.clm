fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if flag[272]:
		FlagUnset flag[272]
		FlagSet flag[1]
		Event fn[0,11]
	elif flag[273]:
		FlagUnset flag[273]
		FlagSet flag[0]
		Event fn[0,12]
	elif flag[274]:
		FlagUnset flag[274]
		FlagSet flag[0]
		Event fn[0,15]
	Return

fn[2]:
	if flag[1]:
		system[1] = 354
		FlagUnset flag[1]
	elif flag[0]:
		system[1] = 117
		FlagUnset flag[0]
	Return

