			Sleep 500ms
			break
		case 5:
			Sleep 600ms
			break
		case 6:
			Sleep 700ms
			break
		default:
			Sleep 800ms
			break
	while 1:
		Emote self 0mm 2000mm 38 39 250ms 2
		Sleep 1000ms
		EmoteStop self
		Sleep 500ms
	Return

