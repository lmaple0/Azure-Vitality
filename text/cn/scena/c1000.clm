fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (-1180, -300, -1100) 2000mm/s 0
		CharWalkToPos self (-15670, -300, 12310) 2000mm/s 0
		CharWalkToPos self (-40270, -300, 12170) 2000mm/s 0
		Sleep 2500ms
		CharWalkToPos self (-15670, -300, 12310) 2000mm/s 0
		CharWalkToPos self (-1180, -300, -1100) 2000mm/s 0
		CharWalkToPos self (26200, -300, -1050) 2000mm/s 0
		Sleep 200ms
		CharTurnTo self 270deg 500deg/s
		Sleep 300ms
	Return

fn[2]:
	while 1:
		CharIdle self (-20480, null, 20170) (-22290, null, 16129) 1000mm/s
		Sleep 300ms
	Return

fn[3]:
	while 1:
		CharWalkToPos self (-19740, -3000, 3190) 1000mm/s 0
		CharWalkToPos self (-22610, -3000, 3390) 1000mm/s 0
		CharTurnTo self 0deg 300deg/s
