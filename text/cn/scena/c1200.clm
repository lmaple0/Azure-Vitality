			但我可不想绕远路啊。{wait}
		}
		TextWait
		TextTalk name[161] {
			快点带我去东侧大道。{wait}
		}
		TextWait
	CharSetPos field_party[0] (-28110, 2000, 23520) 90deg
	EventEnd 4
	Return

