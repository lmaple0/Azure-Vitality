fn[104]:
	EventBegin 1
	if !flag[18]:
		TextTalk name[161] {
			这边是东侧大道吗？{wait}
		}
		TextWait
		TextTalk name[0] {
			#00000F不，不是……{wait}
		}
		TextWait
		Emote name[161] 0mm 1700mm 12 13 250ms 2
		SoundPlay sound[23] 0 100 0
		Sleep 1000ms
		TextTalk name[161] {
			我就知道。{wait}
		}
		TextWait
		TextTalk name[161] {
			……我记得我有说，
			要从东侧大道过去。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00006F是没错……真抱歉。{wait}
		}
		TextWait
		FlagSet flag[18]
	else:
		TextTalk name[161] {
