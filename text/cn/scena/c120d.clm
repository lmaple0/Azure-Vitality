		SystemFlagsUnset 0x00000020
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			{color 5}　《羽扇河丄第一灯塔》

			非相关人士请勿进入。
			　　　　　～克洛斯贝尔市～{color 0}{wait}
		}
		TextWait
		TextClose 0
		_59
		EventEnd 3
	else:
		SystemFlagsSet 0x08000000
		EventBegin 1
		TextMessage null {
			{color 5}有一扇通往地下区域Ｃ的门。
			确定要打开吗？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		_59
		if var[0] == 0:
			CrossFade 500ms
			CamSetDistance 75060 800 20060 0ms
			ED7CamRotate 43deg 14deg 0deg 0ms
			CamPers 600 0ms
			CamZoom 20250 0ms
			FadeWait
			Sleep 500ms
			SoundPlay sound[100] 0 70 0
			ED7ObjPlay object[8] 0 10 0 0
			ObjWait object[8]
			Sleep 500ms
			SoundPlay sound[454] 0 100 0
			SoundPlay sound[145] 2 100 0
			Shake 50 50 3000 1000ms
			ED7ObjPlay object[8] 11 40 0 0
			ObjWait object[8]
			SoundPlay sound[143] 0 100 0
			SoundStop sound[145]
			Sleep 500ms
			LookPointFlagsSet look_point[4] 0x0001
			FlagSet flag[7]
		SystemFlagsUnset 0x08000000
		ED7_Cam69 255 0
		EventEnd 5
	Return

