fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	while 1:
		CharWalkToPos self (14600, 0, 11500) 1000mm/s 0
		CharWalkToPos self (20200, 0, 8200) 1000mm/s 0
		CharWalkToPos self (20200, 0, -6200) 1000mm/s 0
		CharWalkToPos self (14000, 0, -11700) 1000mm/s 0
		CharWalkToPos self (-14000, 0, -11700) 1000mm/s 0
		CharWalkToPos self (-20000, 0, -6400) 1000mm/s 0
		CharWalkToPos self (-20000, 0, 6000) 1000mm/s 0
		CharWalkToPos self (-13200, 0, 11500) 1000mm/s 0
	Return

fn[2]:
	while 1:
		Sleep 3000ms
		CharWalkToPos self (-13000, 2000, 21150) 5000mm/s 0
		CharWalkToPos self (-13000, 2000, 24150) 5000mm/s 0
		ED7_A0 self 5000ms 0 251
		ED7_A0 self 4000ms 0 251
		ED7_A0 self 5000ms 0 251
		ED7_A0 self 4000ms 0 251
		CharWalkToPos self (-13000, 0, 14240) 5000mm/s 0
		CharWalkToPos self (-22130, 0, 5860) 5000mm/s 0
		CharWalkToPos self (-22020, 0, -46700) 5000mm/s 0
		Sleep 3000ms
		CharWalkToPos self (-22130, 0, 5860) 5000mm/s 0
		CharWalkToPos self (-15540, 0, 14240) 5000mm/s 0
		CharWalkToPos self (-15540, 2000, 21150) 5000mm/s 0
		CharWalkToPos self (-52470, 2000, 21150) 5000mm/s 0
	Return

