	TextTalk char[14] {
		我以大小姐的护卫身份同行，
		老实说情况真的很惨。{wait}
	}
	TextWait
	TextTalk char[14] {
		这次的视察目的是评估
		是否能取回保存在地下室的
		耀晶石块和金库内容物……{wait}
	}
	TextWait
	TextTalk char[13] {
		#02906F#3P老实说，目前根本束手无策。{wait}
	} {
		#02901F已经全毁的建筑难以重建，
		要把瓦砾搬走也要花上不少时间。{wait}
	} {
		#02906F幸好银行的功能已经
