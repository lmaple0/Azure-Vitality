		FadeOut 1000ms 0x00000000 255
		FadeWait
		SoundPlay sound[80] 0 100 0
		TextSetPos -1 -1 -1 -1
		TextSetName ""
		TextMessage null {
			开始进行{color 2}委托【主题乐园的兼职２】{color 0}！{wait}
		}
		TextWait
		TextClose 0
		_59
		TextSetPos 14 280 60 3
		FlagSet flag[274]
		QuestTaskSet quest[157] 1
		EventEnd 3
		NewScene "scena/t1390.bin" 0 0 0
		Hcf
	else:
		TextTalk name[0] {
			#00006F不好意思，我们现在
			还有其他事情要办……{wait}
		}
		TextWait
		TextTalk self {
			呜呜，这样啊……
			伤脑筋。{wait}
		}
		TextWait
		TextTalk self {
			如果愿意接受的话，
			请再跟我说一声。{wait}
		}
		TextWait
		TextClose 0
		_59
		ED7_Cam69 255 0
		CharSetPos field_party[0] (38000, -2500, -370) 270deg
		CharFlagsSet field_party[4] 0x0080
		CharFlags2Set field_party[4] 0x8000
		CharFlagsSet field_party[5] 0x0080
		CharFlags2Set field_party[5] 0x8000
		_Char4B char[13] 255
		EventEnd 5
	Return

fn[1]:
