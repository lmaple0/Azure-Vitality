	CharSetPos name[4] (36810, -2500, -1560) 90deg
	CamZoom 11500 1000ms
	FadeWait
	CamWait 121
	if !QuestTaskGet quest[157] 0:
		TextTalk self {
			唉，伤脑筋。
			亏我当初还觉得
			这是个好主意……{wait}
		}
		TextWait
		TextTalk name[0] {
			#00002F呃，不好意思。
			我们是特务支援课的人。{wait}
		} {
			#00000F我们看到请托，所以过来……{wait}
		}
		TextWait
		Emote self 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Sleep 1000ms
		CharTurnToChar self name[0] 500deg/s
		TextTalk self {
			哦哦、哦哦！
			你们来了啊！{wait}
		}
		TextWait
		TextTalk name[0] {
			#00005F看这情况，该不会又
			想要我们穿上
			咪西布偶装了吧……？{wait}
		}
		TextWait
		TextTalk name[2] {
			#00201F咪西出了什么事了吗！？{wait}
		}
		TextWait
		TextTalk name[3] {
			#00306F小缇，你冷静点。
			不是咪西有问题，
			是里面的人出了问题。应该吧。{wait}
		}
		TextWait
		TextTalk name[2] {
			#00207F#4S里 面 没 有 人 ！#3S{wait}
		} {
			#00210F不是的，那个不是咪西，
			而是一个很会模仿咪西的
			大叔……{wait}
		}
		TextWait
		TextTalk name[0] {
			#00012F呃……总之，就是咪西
			遇到问题了对吧？{wait}
		}
		TextWait
		TextTalk name[1] {
			#00100F不过，毕竟是这个状况，
			现在游乐园应该也
			没有营业吧……？{wait}
		}
		TextWait
		TextTalk self {
			没错。可是，正因为是这种情况，
			才该尽我们所能帮忙啊！
			我是这么认为啦。{wait}
		}
		TextWait
		TextTalk self {
			其实，
			我打算在这个港边
			举办慈善活动。{wait}
		}
		TextWait
		TextTalk name[3] {
			#00304F原来如此，既然
			没有客人来，就自己出去
			跟客人互动是吗？{wait}
		}
		TextWait
		TextTalk name[2] {
			#00201F真不愧是咪西……！{wait}
		}
		TextWait
		TextTalk self {
			可是，
			前辈被之前那起事件波及，
			脚受伤了……{wait}
		}
		TextWait
		TextTalk name[0] {
			#00011F咦咦！？
			他还好吗？{wait}
		}
		TextWait
		TextTalk self {
			嗯，幸好
			伤势不严重，但要穿上
			咪西布偶装表演就……{wait}
		}
		TextWait
		TextTalk name[8] {
			#10106F没办法吧。穿着布偶装走动，
			好像是件很辛苦的事。{wait}
		}
		TextWait
		TextTalk name[0] {
			#00001F总之，情况我们了解了。
			你是想要拜托我们
			代替他穿布偶装是吧？{wait}
		}
		TextWait
		TextTalk self {
			你真是通情达理，谢谢你啊。
			你们愿意接受
			这个打工吗？{wait}
		}
		TextWait
		QuestTaskSet quest[157] 0
	else:
		TextTalk self {
			哦，是你们……
			其他的事情都办完了吗？{wait}
		}
		TextWait
		TextTalk self {
			既然这样，
			希望你们务必接受
			穿布偶装的打工。{wait}
		}
		TextWait
	FadeOut 300ms 0x00000000 100
	var[0] = 0
	Menu menu[0] -1 -1 0
		"【接受委托】" // 0
		"【放弃】" // 1
	MenuWait var[0]
	MenuClose menu[0]
	FadeIn 300ms 0x00000000
	_59
	if var[0] == 0:
