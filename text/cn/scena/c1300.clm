	if !QuestFlagsGet quest[125] 0x02:
		TextTalk char[9] {
			#02100F嗯哼哼丅
			是罗伊德你们啊，
			遇见你们的时机正好。{wait}
		} {
			#02109F姐姐我有个
			值得一听的情报。
			我想你们听了不会后悔的哦！{wait}
		}
		TextWait
		TextTalk name[0] {
			#2P#00005F是什么情报呢？{wait}
		}
		TextWait
		TextTalk char[9] {
			#02102F这可不能
			让太多人知道。{wait}
		}
		TextWait
		TextTalk name[1] {
			#00101F该不会是
			有什么危险吧？{wait}
		}
		TextWait
		TextTalk name[4] {
			#4P#10304F呵呵……
			有点可疑呢。{wait}
		} {
			#10302F记者明明是
			最喜欢情报的人，
			却特地要提供情报。{wait}
		}
		TextWait
		TextTalk name[3] {
			#3P#00301F真的很可疑。{wait}
		}
		TextWait
		TextTalk name[8] {
			#10107F不过，如果是事件，
			我们就不能不管啊！{wait}
		}
		TextWait
		TextTalk char[9] {
			#02103F这绝对是事件没错。{wait}
		} {
			#02101F我听说啊，有非法的交易
			要在某地进行。{wait}
		}
		TextWait
		TextTalk name[4] {
			#4P#10300F对记者来说，
			这种情报不是独占
			会比较有利吗？{wait}
		}
		TextWait
		TextTalk char[9] {
			#02109F那当然！
			在现场逮个正着，做条大独家新闻！{wait}
		} {
			#02106F……本来是打算这么刊在报纸上的啦。
			如果交易的人是克洛斯贝尔人的话～{wait}
		}
		TextWait
		Emote name[0] 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Emote name[1] 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Emote name[3] 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Emote name[8] 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Emote name[4] 0mm 2000mm 2 7 80ms 1
		SoundPlay sound[28] 0 100 0
		Sleep 1000ms
		TextTalk name[0] {
			#2P#00003F原来如此……
			是外国人之间的交易啊……{wait}
		}
		TextWait
		TextTalk name[1] {
			#00101F毕竟克洛斯贝尔夹在
			帝国和共和国中间，
			治安实在算不上好。{wait}
		} {
			#00108F再加上因为通商会议的关系，
			警察也忙得不可开交……{wait}
		}
		TextWait
		TextTalk name[3] {
			#3P#00306F也就是说这状况
			最适合非法交易了。{wait}
		}
		TextWait
		TextTalk name[8] {
			#10110F竟然为了犯罪特地
			从外国来到克洛斯贝尔……
			不可原谅！{wait}
		}
		TextWait
		TextTalk name[4] {
			#4P#10301F犯人是外国人的话，可就成不了
			大独家新闻呢。{wait}
		} {
			#10306F因为新闻刊出来的时候，犯人们应该
			都已经跑到国外了吧。{wait}
		}
		TextWait
		TextTalk char[9] {
			#02100F就是这么一回事。
			所以我就想，不如将
			逮捕事件写成报导比较好。{wait}
		}
		TextWait
		TextTalk name[4] {
			#4P#10302F呵呵，真是精打细算呢。{wait}
		}
		TextWait
		TextTalk char[9] {
			#02102F我有犯人的脸部照片哦。
			不过因为非法交易还没发生，
			所以还只是嫌疑犯。{wait}
		}
		TextWait
		TextTalk name[0] {
			#2P#00008F总不能逮捕
			只是带着交易物的人嘛。{wait}
		} {
			#00001F得在交易当下抓到才行。{wait}
		}
		TextWait
		TextTalk name[8] {
			#10101F这场交易是在今天进行吗？
			大概是几点呢？{wait}
		}
		TextWait
		TextTalk char[9] {
			#02103F虽然我没拿到关于时间的情报……
			不过如果地点的情报没错，
			应该还没开始。{wait}
		}
		TextWait
		TextTalk name[8] {
			#10105F咦？明明不知道时间，但是如果
			地点情报没错，就还没开始？
			好像猜谜哦……？{wait}
		}
		TextWait
		TextTalk name[3] {
			#3P#00305F什么意思？{wait}
		}
		TextWait
		TextTalk name[1] {
			#00100F……该不会那个地点
			是营业时间
			比较晚开始的店吧？{wait}
		}
		TextWait
		TextTalk char[9] {
			#02102F艾莉果然厉害。
			做为交易地点的店家还没开门，
			所以应该还没开始。{wait}
		} {
			#02109F罗伊德，怎么办呢？{wait}
		}
		TextWait
		TextTalk name[0] {
			#2P#00003F（好像会变成非法交易的搜查。
			要做好准备才行……）{wait}
		}
		TextWait
		QuestFlagsSet quest[125] 0x02
	else:
