fn[0]:
	switch random % 8:
		case 0:
			ED7_A0 self 1450ms 0 251
			break
		case 1:
			ED7_A0 self 1550ms 0 251
			break
		case 2:
			ED7_A0 self 1600ms 0 251
			break
		case 3:
			ED7_A0 self 1400ms 0 251
			break
		case 4:
			ED7_A0 self 1650ms 0 251
			break
		case 5:
			ED7_A0 self 1350ms 0 251
			break
		case 6:
			ED7_A0 self 1500ms 0 251
			break
		default:
			ED7_A0 self 1500ms 0 251
			break
	while 1:
		ED7_A0 self 1500ms 0 251
	Return

fn[1]:
	if system[0] == 102:
		CharSetPos field_party[0] (-230, -1450, -33980) 0deg
		CharSetPos field_party[1] (-230, -1450, -33980) 0deg
		CharSetPos field_party[2] (-230, -1450, -33980) 0deg
		CharSetPos field_party[3] (-230, -1450, -33980) 0deg
		if system[15] != 255:
			CharSetPos field_party[4] (-230, -1450, -33980) 0deg
			CharSetPos field_party[5] (-230, -1450, -33980) 0deg
		elif system[14] != 255:
			CharSetPos field_party[4] (-230, -1450, -33980) 0deg
		system[0] = 100
	global[7] = 11
	if flag[3089]:
		CharFlagsSet char[0] 0x0080
	elif flag[3074]:
		CharFlagsSet char[0] 0x0080
	elif flag[2861]:
	elif flag[2848]:
	elif flag[2837]:
	elif flag[2832]:
	elif flag[2816]:
	elif flag[2573]:
	elif flag[2564]:
		CharSetPos char[0] (1600, 0, -21430) 180deg
		CharFlagsUnset char[1] 0x0080
		CharFlagsUnset char[2] 0x0080
		CharFlagsUnset char[3] 0x0080
		CharFlagsUnset char[4] 0x0080
		CharFlagsSet char[1] 0x8000
		CharFlagsSet char[2] 0x8000
		CharFlagsSet char[3] 0x8000
		CharFlagsSet char[4] 0x8000
		CharFlagsSet char[0] 0x8000
		if flag[2565] && !QuestFlagsGet quest[125] 0x10:
			CharFlagsUnset char[9] 0x0080
			CharFlagsSet char[9] 0x8000
	elif flag[2560]:
	elif flag[2369]:
	elif flag[2353]:
	if flag[272]:
		FlagUnset flag[272]
		Event fn[0,4]
	if system[0] == 100 && QuestFlagsGet quest[115] 0x02 && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40 && !flag[3626] && flag[2717]:
		SystemFlagsSet 0x10000000
		Event fn[0,5]
	if flag[2374] && QuestFlagsGet quest[106] 0x10 && QuestFlagsGet quest[107] 0x10 && QuestFlagsGet quest[108] 0x10 && !flag[2375]:
		SystemFlagsSet 0x10000000
		Event fn[1,0]
	Return

fn[2]:
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		EffLoad eff[9] "map/mprain00.eff"
		EffPlay eff[9] eff_instance[7] null 0 (0, 0, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 1000ms
		MapColor 0x00B4B4B4 0ms
		Fog 0xFFB5A095 13 415 0
		ED7_76_0 object[255] "sky" 1
		ED7_76_0 object[255] "sky1" 1
		ED7_76_1 object[255] "sky2" 1
		ED7_76_0 object[255] "sd_mul" 1
		SoundPlay sound[128] 1 100 0
	if flag[2369] && !flag[2560] && !flag[2453]:
		ED7_78 object[2] char[8]
		ObjFlagsUnset object[2] 0x0004
		ObjFlagsSet object[2] 0x1000
		ED7_76_0 object[2] "light" 1
		CharFlagsUnset char[8] 0x0080
		CharFlagsSet char[8] 0x8000
		CharSetPos char[8] (-4990, 0, 2500) 180deg
		Sc_D1 char[8] 0 180000 0 0ms
	ObjFlagsUnset object[1] 0x0010
	ObjFrame object[1] 20
	TriggerFlagsSet trigger[0] 0x0080
	if QuestFlagsGet quest[115] 0x02 && !QuestFlagsGet quest[115] 0x10 && !QuestFlagsGet quest[115] 0x40 && flag[2717]:
		TriggerFlagsUnset trigger[0] 0x0080
	if flag[2564] && !flag[2573]:
		ObjFlagsUnset object[1] 0x0010
		ObjFrame object[1] 0
		ObjFlagsUnset object[3] 0x0004
		ObjFlagsUnset object[4] 0x0004
		ObjFlagsUnset object[5] 0x0004
	Return

fn[3]:
	TextStart self
	if flag[3089]:
	elif flag[3074]:
	elif flag[2861]:
		TextTalk self {
			竟然在玛因兹发生占领事件……
			难道真是帝国在背后搞鬼吗……？{wait}
		}
		TextWait
		TextTalk self {
			……总之，要提高警觉。{wait}
		}
		TextWait
	elif flag[2848]:
		if !flag[0]:
			TextTalk self {
				早安，特务支援课的各位。
				虽然大家都淋了雨，
				不过今天还是努力工作吧。{wait}
			}
			TextWait
			TextTalk self {
				听兰菲小姐说，
				雨下午好像就会停了，
				就忍耐一下吧。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				虽然大家都淋了雨，
				不过今天还是努力工作吧。{wait}
			}
			TextWait
			TextTalk self {
				听兰菲小姐说，
				雨下午好像就会停了，
				就忍耐一下吧。{wait}
			}
			TextWait
	elif flag[2837]:
		if !flag[0]:
			TextTalk self {
				嗯，难得会有
				这么小的孩子
				一个人来访。{wait}
			}
			TextWait
			TextTalk self {
				是来找
				大楼里的家人吗？{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				哎呀，糟糕糟糕。
				我也真是的，
				怎么开始探起客人的底了。{wait}
			}
			TextWait
			TextTalk self {
				身为保安部的人，嘴巴可得小心点。{wait}
			}
			TextWait
	elif flag[2832]:
		TextTalk self {
			早安。
			今天早上的天气也很舒服呢。{wait}
		}
		TextWait
		TextTalk self {
			这地方还是老样子，
			视野良好、
			空气又新鲜，最棒了。{wait}
		}
		TextWait
	elif flag[2816]:
		TextTalk self {
			克洛斯贝尔能否
			独立成一个国家……
			真是值得玩味的话题呢。{wait}
		}
		TextWait
		TextTalk self {
			虽然我觉得这件事
			也和ＩＢＣ的方针有关……
			不过凭我实在想像不出细节呢。{wait}
		}
		TextWait
	elif flag[2573]:
		if !QuestFlagsGet quest[122] 0x10:
			if !flag[0]:
				TextTalk self {
					昨天我在近距离下
					看到来访ＩＢＣ的
					洛克史密斯总统了……{wait}
				}
				TextWait
				TextTalk self {
					果然啊，一个人能当上
					统领那么一个大国的领导者，
					连存在感都不同凡响呢。{wait}
				}
				TextWait
				TextTalk self {
					不是说他外表长得如何，
					怎么说呢、就是可以感觉到
					气势之类的东西吧。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					话说回来，今天早上好像
					有不明人士闯进我们ＩＢＣ。{wait}
				}
				TextWait
				TextTalk self {
					虽然我想没有
					发生什么怪事……
					不过没能发现他让我很震惊。{wait}
				}
				TextWait
		else:
			TextTalk self {
				怪盗Ｂ像传闻中的一样，
				真是个怪人。{wait}
			}
			TextWait
			TextTalk self {
				竟然把偷来的东西
				乱丢在自治州各地……
				那家伙到底想做什么啊？{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[0]:
			TextTalk self {
				啊，你们等一下。
				不好意思，
				今天ＩＢＣ休息喔。{wait}
			}
			TextWait
			TextTalk self {
				说是这么说，
				其实是洛克史密斯总统
				现在正在里面视察啦。{wait}
			}
			TextWait
			TextTalk self {
				如果有事的话，
				麻烦明天再来吧。{wait}
			}
			TextWait
			if flag[2647]:
				TextTalk name[0] {
					#00005F总统视察吗……？{wait}
				} {
					#00003F记得昨天兰菲小姐
					也是这么说的。{wait}
				}
				TextWait
			else:
				TextTalk name[0] {
					#00005F总统视察吗……？{wait}
				}
				TextWait
			TextTalk name[3] {
				#00300F警备状态好像
				还真不是盖的。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00100F是啊，总之我们
				还是在没妨碍到人之前
				乖乖离开好了。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				不好意思，
				今天ＩＢＣ休息喔。{wait}
			}
			TextWait
			TextTalk self {
				如果有事的话，
				麻烦明天再来吧。{wait}
			}
			TextWait
	elif flag[2560]:
		TextTalk self {
			明天就要举行通商会议了。{wait}
		}
		TextWait
		TextTalk self {
			街上的警戒等级已经提高，
			我们保安部自然也充满干劲。{wait}
		}
		TextWait
	elif flag[2369]:
		if !flag[2453]:
			if !flag[0]:
				TextTalk self {
					我刚才看到
					库罗伊斯总裁、不对，
					是库罗伊斯市长前来。{wait}
				}
				TextWait
				TextTalk self {
					市长基本上
					都窝在新市政厅大楼里，
					不过有时候也会像这样跑来。{wait}
				}
				TextWait
				TextTalk self {
					……话说回来，能兼顾两边
					真是不得了啊。{wait}
				}
				TextWait
				TextTalk self {
					而且两边的工作
					都处理得很好，
					实在令人佩服。{wait}
				}
				TextWait
				FlagSet flag[0]
			else:
				TextTalk self {
					克洛斯贝尔市长和ＩＢＣ总裁……
					仔细想想，
					能兼顾两边真是不得了。{wait}
				}
				TextWait
				TextTalk self {
					而且两边的工作
					都处理得很好，
					实在令人佩服。{wait}
				}
				TextWait
		else:
			TextTalk self {
				你问库罗伊斯市长的话，
				他早就回市政厅了喔。{wait}
			}
			TextWait
			TextTalk self {
				动作还是那么快。{wait}
			}
			TextWait
	elif flag[2353]:
		if !flag[0]:
			TextTalk self {
				你好。
				欢迎来到ＩＢＣ总公司大楼。{wait}
			}
			TextWait
			TextTalk self {
				有事的话请去找柜台吧。{wait}
			}
			TextWait
			TextTalk self {
				我们自豪的柜台小姐应该会
				无微不至地为你服务。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk self {
				有事的话请去找柜台吧。{wait}
			}
			TextWait
			TextTalk self {
				我们自豪的柜台小姐应该会
				无微不至地为你服务。{wait}
			}
			TextWait
	TextEnd self
	Return

