	}
	TextWait
	TextTalk name[3] {
		#1330030001V#00306F#11P看来瓦鲁多是打算彻底
		避开他那些小弟啊……{wait}
	} {
		#1330030002V#00301F他们还反过来追问我们
		有没有瓦鲁多的行踪啊。{wait}
	}
	TextWait
	TextTalk name[8] {
