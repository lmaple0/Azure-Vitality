	TextStart null
	FadeOut 300ms 0x00000000 100
	TextSetName ""
	TextSetPos -1 -1 -1 -1
	TextMessage null {
		{color 5}公寓『伊美黛馆』

		　～　现在关闭中　～{wait}
	}
	TextWait
	TextClose 0
	if ItemHas item[801] 0:
		_59
		TextSetPos -1 280 60 3
		TextMessage null {
			{color 5}是否要使用伊美黛馆的钥匙？{wait}
		}
		Menu menu[0] -1 -1 1
			"是" // 0
			"否" // 1
		MenuWait var[0]
		MenuClose menu[0]
		TextClose 0
		if var[0] == 0:
			_59
			Sleep 500ms
			SoundPlay sound[806] 0 100 0
			Sleep 1000ms
			TextMessage null {
				{color 5}打开了『伊美黛馆』的门锁。{wait}
			}
			TextWait
			TextClose 0
			QuestTaskSet quest[103] 1
			FlagSet flag[2457]
			ObjFlagsSet object[1] 0x0010
			LookPointFlagsSet look_point[1] 0x0001
	else:
		FadeIn 300ms 0x00000000
		if !flag[13]:
			TextTalk name[0] {
				#00000F……门好像被锁上了。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00105F击退魔兽的支援请求的
				地点是这间公寓没错吧。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F我记得这间公寓的
				管理员是古董店店长
				『伊美黛夫人』吧。{wait}
			} {
				#00000F我们到小巷里的
				古董店去借
				钥匙过来吧。{wait}
			}
			TextWait
			FlagSet flag[13]
		else:
			TextTalk name[0] {
				#00000F击退魔兽的支援
				请托的地点应该是
				这间公寓没错。{wait}
			} {
				#00000F我们到小巷里的
				古董店去借
				钥匙过来吧。{wait}
			}
			TextWait
	FadeIn 300ms 0x00000000
	_59
	TextSetPos -1 280 60 3
	TextEnd null
	Return

