	CharFlags2Unset field_party[4] 0x8000
	FadeWait
	TextTalk name[0] {
		#6P#00001F米蕾优三尉……
		你来市区了啊？{wait}
	}
	TextWait
	TextTalk char[9] {
		#07903F嗯，刚刚才来的。{wait}
	} {
		#07900F我在等要在这里继续开会的
		司令和副司令。{wait}
	}
	TextWait
	TextTalk name[1] {
		#6P#00103F就是课长也从昨天晚上就
		参加的那个会议……{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#00201F警备队的司令们留下来继续开会，
		也就是说……在对策的拟定方面
		也遇上瓶颈了吗？{wait}
	}
	TextWait
	Emote char[9] 0mm 2000mm 24 27 250ms 0
	Sleep 1000ms
	EmoteStop char[9]
	TextTalk char[9] {
		#07901F……你们几个。
		关于今天早上你们课长
		问我的事情……{wait}
	} {
		听说兰迪
		下落不明？{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00003F……是的。{wait}
	} {
		#00001F根据推测，
		他恐怕是……
		去玛因兹山道了吧？{wait}
	}
	TextWait
	TextTalk char[9] {
		#07908F……这样啊……{wait}
	}
	TextWait
	Emote char[9] 0mm 2000mm 24 27 250ms 0
	Sleep 2000ms
	EmoteStop char[9]
	TextTalk name[4] {
		#6P#10300F……你还好吗？{wait}
	}
	TextWait
	TextTalk char[9] {
		#07903F……嗯，我没事。
		不过……{wait}
	} {
		#07901F兰迪之所以会失踪，
		应该跟他的过去有关……
		对吧？{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00008F这、这个嘛……{wait}
	}
	TextWait
	TextTalk char[9] {
		#07908F……虽然很不甘心，
		但我不是很了解
		兰迪的过去。{wait}
	} {
		也不知道
		在实战训练的时候，
		他一直不使用步枪的原因。{wait}
	} {
		#07901F不过……我知道他这次的举动，
		让大家非常担心他，
		真的是很笨的行为。{wait}
	}
	TextWait
	TextTalk name[8] {
		#6P#10108F米蕾优三尉……{wait}
	}
	TextWait
	TextTalk name[2] {
		#6P#00203F……的确，不只是笨，而是大笨蛋。{wait}
	}
	TextWait
	TextTalk char[9] {
		#07903F……警备队也损失惨重。
		司令他们之后应该会
		再编组一支救援部队。{wait}
	} {
		我们在接到命令前不能行动……
		更不能为了兰迪一个人
		擅自出动。{wait}
	} {
		#07900F所以，各位……
		那个笨蛋就拜托你们了。{wait}
	}
	TextWait
	TextTalk name[0] {
		#6P#00000F……交给我们吧。
		我们一定会把兰迪带回来……！{wait}
	}
	TextWait
	_59
	_Char4B char[9] 255
	CharFlagsSet field_party[4] 0x0080
	CharFlags2Set field_party[4] 0x8000
	FlagSet flag[2940]
	EventEnd 5
	Return

