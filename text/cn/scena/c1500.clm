		嗯，因为总统演说的关系，
		国界门也有好几个人
		被调来支援警备工作。{wait}
	}
	TextWait
	TextTalk char[90] {
		罗金斯也在那边
		巡逻喔。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00302F#12P哈哈，原来是这样。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00000F#12P（他是……）{wait}
	}
	TextWait
	TextTalk name[1] {
		#00100F#6P（好像是兰迪在警备队时的
		　同袍。）{wait}
	}
	TextWait
	TextTalk char[90] {
		哎呀，话说回来，
		事情还真是不得了。{wait}
	}
	TextWait
	TextTalk char[90] {
		我们突然
		拿到这套军服，
		一开始也是吓了一跳。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00306F#12P嗯，事情发生得太突然，
		让人摸不着头绪……{wait}
	} {
		#00300F仔细一想，包括这套军服在内，
		一切都准备得太周到了。{wait}
	}
	TextWait
	TextTalk char[90] {
		总统一定是从很早之前
		就开始做准备了吧？{wait}
	}
	TextWait
	TextTalk char[90] {
		国防军的装备好像也
		可望获得强化，
		我们得打起精神来才行。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00305F#12P嗯，好吧……{wait}
	}
	TextWait
	TextTalk name[2] {
		#00201F#12P（……国防军的士兵们
		　好像都相当乐见
		　这次的重新编组。）{wait}
	}
	TextWait
	TextTalk name[1] {
		#00106F#6P（跟其他国家的正规军比起来，
		　他们的待遇确实比较不好，
		　是可以理解他们的心情，不过……）{wait}
	}
	TextWait
	TextTalk char[90] {
		顺道一提，成了国防军之后，
		我们也可以用一般军队的
		阶级称号了。{wait}
	}
	TextWait
	TextTalk char[90] {
		以前都叫一尉、二尉、三尉，
		现在改称上尉、中尉、少尉了。{wait}
	}
	TextWait
	TextTalk char[90] {
		称呼军官的时候叫错阶级非常失礼，
		所以得要小心一点喔！{wait}
	}
	TextWait
	TextTalk name[3] {
		#00300F#12P嗯，谢谢忠告。{wait}
	} {
		#00303F也就是说，
		米蕾优原本是『三尉』……
		从今以后就变成『少尉』了吧？{wait}
	} {
		#00309F哈哈，捉弄她的材料又多了一个。{wait}
	}
	TextWait
	TextTalk name[0] {
		#00006F#12P喂喂喂……{wait}
	}
	TextWait
	TextTalk char[90] {
		呃，这个嘛……
		嗯，算是吧……{wait}
	}
	TextWait
	Emote name[0] 0mm 2000mm 0 1 250ms 2
	SoundPlay sound[29] 0 100 0
	Sleep 50ms
	Emote name[1] 0mm 2000mm 0 1 250ms 2
	SoundPlay sound[29] 0 100 0
	Sleep 50ms
	Emote name[3] 0mm 2000mm 0 1 250ms 2
	SoundPlay sound[29] 0 100 0
	Sleep 50ms
	Emote name[2] 0mm 2000mm 0 1 250ms 2
	SoundPlay sound[29] 0 100 0
	Sleep 1000ms
	TextTalk name[3] {
		#00305F#12P你那是什么
		含糊的回答啊……{wait}
	}
	TextWait
	TextTalk name[1] {
		#00105F#12P阶级应该
		没有说错吧？{wait}
	}
	TextWait
	TextTalk char[90] {
		不，跟那个没有关系……{wait}
	}
	TextWait
	Emote char[90] 0mm 2000mm 24 27 250ms 0
	Sleep 2000ms
	EmoteStop char[90]
	TextTalk char[90] {
		我说啊，兰迪。
		其实……{wait}
	}
	TextWait
	_Char4A char[98] 1
	CharTurnToChar char[98] char[90] 500deg/s
	Shake 0 100 3000 200ms
	TextSetPos -1 -1 -1 -1
	TextSetName "国防军军官的声音"
	TextTalk char[98] {
		#4S……卡塔！！
		警备中不准私下交谈！！#3S{wait}
	}
	TextWait
	TextClose 0
	_59
	TextSetPos -1 280 60 3
	Emote char[90] 0mm 2000mm 2 7 80ms 1
	SoundPlay sound[28] 0 100 0
	Sleep 500ms
	CharTurnTo char[90] 45deg 500deg/s
	TextTalk char[90] {
		……是、是的！！{wait}
	}
	TextWait
	_Char4B char[98] 1
	CharTurnToChar char[90] name[3] 300deg/s
	TextTalk char[90] {
		……抱歉，兰迪。
		详细情况我下次再跟你说。{wait}
	}
	TextWait
	TextTalk name[3] {
		#00300F#12P虽然不太懂……
		但抱歉喔，一直拉着你聊天。{wait}
	}
	TextWait
	TextTalk char[90] {
		哈哈，不用放在心上。{wait}
	}
	TextWait
	TextTalk char[90] {
		对了对了，你们警察应该也
		编入国防军了吧？{wait}
	}
	TextWait
	TextTalk char[90] {
		以后我们又是同事了。
		请多多指教啦。{wait}
	}
	TextWait
	CharWalkToPos char[90] (-3160, 0, -12800) 2000mm/s 0
	CharTurnTo char[90] 180deg 300deg/s
	_Char4B char[90] 1
	TextTalk name[3] {
		#00306F#12P伤脑筋……
		真是哪壶不开提哪壶。{wait}
	}
	TextWait
	TextTalk name[2] {
		#00201F#12P总之，我们还是先
		回去比较好吧？{wait}
	}
	TextWait
	TextTalk name[0] {
		#00001F#12P嗯，那我们走吧。{wait}
	}
