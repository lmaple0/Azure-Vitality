			ED7MenuAdd menu[0] "在导力车上休息"
			var[3] += 1
			var[4] += 1
		ED7MenuAdd menu[0] "放弃"
		ED7MenuShow menu[0] 65535 65535 1
		MenuWait var[0]
		MenuClose menu[0]
		if var[0] == 0:
			TextTalk name[0] {
				#00001F……现在不需要勉强移动它。
				等事件平息之后，再送去修理吧。{wait}
			}
			TextWait
		elif var[0] == var[3]:
			TextClose 0
			BgmStop 3000ms
			FadeOut 1000ms 0x00000000 255
			FadeWait
			_59
			SoundPlay sound[13] 0 100 0
			if flag[392]:
				PartySetAttr name[255] 255 0
			elif flag[391]:
