fn[7]:
	if flag[2851] && !flag[2852]:
		Call fn[0,48]
		Return
	TextStart char[0]
	if flag[3385]:
		if !flag[0]:
			TextTalk char[0] {
				目前，
				在麦克道尔议长的主导下，
				兰花塔已经纳入他的管辖。{wait}
			}
			TextWait
			TextTalk char[0] {
				虽然还有很多混乱的状况……
				但这里是为了市民建设的大楼，
				这点是不会改变的。{wait}
			}
			TextWait
			TextTalk char[0] {
				今后还请
				多多指教。{wait}
			}
			TextWait
			FlagSet flag[0]
		else:
			TextTalk char[0] {
				兰花塔是
				为了市民建设的大楼，
				这点是不会改变的。{wait}
