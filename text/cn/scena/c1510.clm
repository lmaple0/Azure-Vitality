fn[52]:
	SystemFlagsSet 0x00000080
	FlagUnset flag[394]
	var[0] = 0
	while var[0] != 255:
		ED7MenuNew menu[0]
		ED7MenuAdd menu[0] "搭乘导力车移动"
		var[3] = 0
		var[4] = 0
