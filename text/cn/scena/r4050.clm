	EventBegin 1
	CharFlagsUnset field_party[4] 0x0080
	CharFlags2Unset field_party[4] 0x8000
	CharFlagsUnset field_party[5] 0x0080
	CharFlags2Unset field_party[5] 0x8000
	switch random % 7:
		case 0:
			TextTalk name[0] {
				#00005F这是……{wait}
			}
			break
		case 1:
			TextTalk name[1] {
				#00105F哎呀呀，这是……{wait}
			}
			break
		case 2:
			TextTalk name[2] {
				#00205F啊……前方有东西。{wait}
			}
			break
		case 3:
			TextTalk name[3] {
				#00305F哦！这东西如何啊？{wait}
			}
			break
		case 4:
			TextTalk name[8] {
				#10105F啊！这是……{wait}
			}
			break
		case 5:
			TextTalk name[4] {
				#10305F那里有东西在发光……{wait}
			}
			break
		default:
			TextTalk name[165] {
				#07905F啊……等等。
				有东西掉在那里……！{wait}
			}
			break
	TextWait
	switch random % 4:
		case 0:
			TextTalk name[165] {
				#07900F嗯……这是某种零件吗？
				不像是警备队的东西呢。{wait}
			}
			break
		case 1:
			TextTalk name[165] {
				#07900F这是……导力车的零件？
				是从上面的街道掉下来的吗？{wait}
			} {
				无论是什么，这和队员没有关联吧。{wait}
			}
			break
		case 2:
			TextTalk name[165] {
				#07900F这……只是根树枝呢。
				因为潮湿反射光线，
				才会误认是金属。{wait}
			}
			break
		default:
			TextTalk name[165] {
				#07900F这似乎是警备队
				装备中的皮带扣……{wait}
			} {
				已经生锈了，看起来不像是
				最近才掉落的。{wait}
			}
			break
	TextWait
	switch random % 7:
		case 0:
			TextTalk name[0] {
				#00001F嗯，去找其它的地方吧。{wait}
			}
			break
		case 1:
			TextTalk name[1] {
				#00106F看来不是呢，去找其他的地方吧。{wait}
			}
			break
		case 2:
			TextTalk name[2] {
				#00206F看来不是这里的样子。{wait}
			}
			break
		case 3:
			TextTalk name[3] {
				#00306F不是这里，去找其他的地方吧。{wait}
			}
			break
		case 4:
			TextTalk name[8] {
				#10101F去找其它的地方吧，
				一定会有什么线索！{wait}
			}
			break
		case 5:
			TextTalk name[4] {
				#10306F这里好像也不对。{wait}
			}
			break
		default:
			TextTalk name[165] {
				#07906F不是这里呢，去找其他的地方吧。{wait}
			}
			break
	TextWait
	CharFlagsSet field_party[4] 0x0080
	CharFlags2Set field_party[4] 0x8000
	CharFlagsSet field_party[5] 0x0080
	CharFlags2Set field_party[5] 0x8000
	EventEnd 4
	Return

