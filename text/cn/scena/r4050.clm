fn[3]:
	SystemFlagsSet 0x08000000
	if !flag[3876]:
		SoundPlay sound[14] 0 100 0
		ED7_74 object[0] 0 30
		ED7ObjPlay object[0] 0 30 0 0
		Sleep 500ms
		if !flag[4282]:
			CharColor char[4] 0x00FFFFFF 0ms
			CharTurnToChar char[4] field_party[0] 0deg/s
			_Char91 char[4] 0 1000 0 0 0
			Fork char[4] fork[1]:
				_Char91 self 0 -1000 0 1000 0
			Fork char[4] fork[2]:
				CharColor self 0xFFFFFFFF 1000ms
			CharFlagsUnset char[4] 0x0080
			CharFlagsSet char[4] 0x8000
			TextMessage name[742] {
				{color 5}魔兽出现了！{color 0}{wait}
			}
			TextWait
			TextClose 0
			ForkWait char[4] fork[1]
			ED7Battle battle[4] null 0 0 11 null
			CharFlagsSet char[4] 0x0080
			CharFlagsUnset char[4] 0x8000
			switch system[3]:
				case 0:
					FlagSet flag[4282]
