fn[5]:
	TextStart self
	if flag[2573]:
		if !flag[2636]:
			Call fn[0,12]
		else:
			TextTalk self {
				#07900F现在，索妮亚司令跟道格拉斯
				副司令正在讨论恐攻对策。{wait}
			} {
				#07903F请不要去打扰他们喔。{wait}
			}
			TextWait
	elif flag[2564]:
		if !flag[2636]:
			Call fn[0,12]
		elif !flag[1]:
			TextTalk self {
				#07900F要找索妮亚司令的话，
				她今天在游憩区米修拉姆
				指挥警备。{wait}
			} {
				#07903F因为是在迎宾馆招待
				各国贵宾，所以那里是
				最重要的警备地点。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00305F也就是说，
				今天是由你来代替司令
				指挥贝尔加德门的队员啊。{wait}
			} {
				#00306F唉，就凭米蕾优
				真的有办法代替
				那位索妮亚司令吗？{wait}
			}
			TextWait
			CharTurnToChar self name[3] 500deg/s
			TextTalk self {
				#07901F没、没礼貌……！{wait}
			} {
				#07903F……哼，才不需要你来操心。
				前司令还在的时候，
				我就常常做类似的事情了。{wait}
			} {
				#07907F索妮亚司令不在的时候，
				我绝对会保护大家给你看！{wait}
			}
			TextWait
			TextTalk name[3] {
				#00309F哈哈，有这种气势应该就没问题了吧。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				#07903F前司令还在的时候，
				我经常被任命为代理，
				负责国界门的指挥。{wait}
			} {
				#07901F索妮亚司令不在的时候，
				我绝对会保护大家给你看！{wait}
			}
			TextWait
	elif flag[2560]:
		if !flag[2636]:
			Call fn[0,12]
		elif !flag[1]:
			TextTalk self {
				#07904F不、不过，
				先不提我晋升的事……{wait}
			} {
				#07900F为了迎接通商会议，
				国界门也会加强警戒。{wait}
			} {
				请你们留意，
				不要跟旅客
				发生纠纷喔。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				#07900F为了迎接通商会议，
				国界门也会加强警戒。{wait}
			} {
				请你们留意，
				不要跟旅客
				发生纠纷喔。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[6]:
	TextStart self
	if flag[3074]:
	elif flag[2861]:
	elif flag[2848]:
	elif flag[2832]:
		if !flag[1]:
			TextTalk self {
				#07900F啊，你们……{wait}
			} {
				在来贝尔加德门的路上，
				没有碰到什么危险的状况？{wait}
			}
			TextWait
			TextTalk name[0] {
				#00005F咦……？{wait}
			}
			TextWait
			TextTalk name[3] {
				#00305F跟平常差不多，应该
				没什么不一样的地方吧。{wait}
			}
			TextWait
			TextTalk self {
				#07900F这样啊……{wait}
			} {
				#07903F……看来今天似乎是
				不会出现了吧。{wait}
			}
			TextWait
			Emote field_party[0] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[1] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[2] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Emote field_party[3] 0mm 2000mm 0 1 250ms 2
			SoundPlay sound[29] 0 100 0
			Sleep 1000ms
			TextTalk self {
				#07900F不，别放在心上。
				毕竟这是我们的工作。{wait}
			} {
				#07903F不过，如果搞不好的话，
				我最近有可能会找你们
				商量这件事就是了……{wait}
			}
			TextWait
			TextTalk name[3] {
				#00303F嗯，虽然不太清楚，不过……
				需要帮助的话，随时都可以来找我们。{wait}
			}
			TextWait
			TextTalk self {
				#07902F没问题，到时还请多多指教。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				#07903F……看来今天似乎是
				不会出现了吧……{wait}
			} {
				#07901F总之，目前要全力对抗
				两大国的紧张状态才行呢。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[2900]:
			TextTalk name[3] {
				#00309F嗨！米蕾优准尉。
				最近过得好吗？{wait}
			}
			TextWait
			CharTurnToChar self name[3] 500deg/s
			TextTalk self {
				#07901F……你啊，
				你是故意的吧？{wait}
			} {
				#07906F之前明明才说过
				我已经晋升到三尉的事情……
				真是的。{wait}
			}
			TextWait
			TextTalk name[8] {
				#10109F啊哈哈……无论如何，
				恭喜你晋升。{wait}
			}
			TextWait
			CharTurnToChar self name[8] 500deg/s
			TextTalk self {
				#07909F呵呵，谢谢你，上士。{wait}
			} {
				#07903F虽然我很感激能够晋升，不过……
				背负的责任也变得
				越来越大了吧。{wait}
			} {
				#07901F今后必须精益求精、
				加倍努力才行呢。{wait}
			}
			TextWait
			TextTalk name[3] {
				#00306F伤脑筋，你还是老样子，
				总是认真过度呢。{wait}
			} {
				#00302F只知道努力的话，迟早会累坏喔。
				随便敷衍一下就行了啦，要敷衍喔。{wait}
			}
			TextWait
			CharTurnToChar self name[3] 500deg/s
			Emote self 0mm 2000mm 12 13 250ms 2
			SoundPlay sound[23] 0 100 0
			Sleep 1000ms
			TextTalk self {
				#07901F难得人家在说
				这么正经的事情……
				兰迪你这个笨蛋！{wait}
			}
			TextWait
			TextTalk name[8] {
				#10112F啊、啊哈哈……
				（就算晋升了，她也还是老样子呢……）{wait}
			}
			TextWait
			FlagSet flag[2900]
			CharTurnTo self 180deg 0deg/s
		elif !flag[2901]:
			TextTalk name[3] {
				#00300F喔，对了……
				庆祝你晋升送的那个礼物，
				你有戴上吗？{wait}
			} {
				就是我在米修拉姆珠宝店
				买的那个啊。{wait}
			}
			TextWait
			if !flag[2769]:
				TextTalk name[0] {
					#00005F哦……
					你有送她礼物啊？{wait}
				}
				TextWait
			else:
				TextTalk name[0] {
					#00002F嗯……这么说来，
					你买的好像是胸针对吧？{wait}
				}
				TextWait
			CharTurnToChar self name[3] 500deg/s
			TextTalk self {
				#07906F我说你呀……
				当然不可能戴啊。{wait}
			} {
				#07900F身为警备队的军官，
				当然不能表现得那么轻浮，
				所以我有妥善收藏起来……{wait}
			}
			TextWait
			Emote self 0mm 2000mm 2 7 80ms 1
			SoundPlay sound[28] 0 100 0
			Sleep 1000ms
			Emote self 0mm 2000mm 40 43 100ms 0
			Sleep 1000ms
			EmoteStop self
			TextTalk self {
				#07911F不、不对……不是这样的！
				我才没有妥善收藏呢！{wait}
			} {
				#07909F没、没错！我很粗鲁地把它丢到
				柜子里面的最里面去了……！{wait}
			}
			TextWait
			TextTalk name[3] {
				#00309F哇哈哈，别害羞啦。{wait}
			}
			TextWait
			TextTalk name[2] {
				#00204F（……这场面好温馨。）{wait}
			}
			TextWait
			FlagSet flag[2901]
			CharTurnTo self 180deg 0deg/s
		else:
			TextTalk self {
				#07902F嗯、嗯哼，总之……
				既然已经晋升了，
				我当然会比之前更加努力喔。{wait}
			} {
				#07903F为了多少能够帮上司令的忙，
				我也得精益求精、加倍努力才行。{wait}
			}
			TextWait
	TextEnd self
	Return

fn[7]:
	Call fn[0,8]
	Return

fn[8]:
	TextStart char[2]
	if flag[3074]:
		name[8].5 = char[2].4
		char[2].5 = char[2].4
		CharFlagsUnset char[2] 0x0010
		CharTurnToChar char[2] name[8] 0deg/s
		char[2].4 = (char[2].4 + 360) % 360
		char[2].4 = char[2].4 + 360 - char[2].5
		char[2].5 = char[2].4 / 180
		if char[2].4 <= 45 | char[2].4 >= 315 && char[2].4 <= 405 | char[2].4 >= 675:
		elif char[2].5 < 1:
			char[2].8 = 2
		elif char[2].5 > 2:
			char[2].8 = 1
		else:
			char[2].8 = char[2].5
		char[2].4 = name[8].5
		name[8].5 = 0
		char[2].5 = 0
		CharFlagsSet char[2] 0x0010
		if !flag[2]:
			TextTalk char[2] {
				#02008F…………{wait}
			}
			TextWait
			TextTalk name[0] {
				#00001F索妮亚司令……
				你有什么烦恼吗？{wait}
			}
			TextWait
			TextTalk char[2] {
				#02003F……关于警备队的编组，我有点烦恼。{wait}
			} {
				#02000F警备队在玛因兹山道严重受创，
				要复原成原本的状态，
				一定需要很多时间吧。{wait}
			}
			TextWait
			TextTalk name[1] {
				#00108F果然是这样啊……{wait}
			}
			TextWait
			TextTalk name[8] {
				#10108F…………{wait}
			}
			TextWait
			TextTalk char[2] {
				#02000F……诺艾儿上士。
				你看起来闷闷不乐呢。{wait}
			} {
				#02003F你在后悔做了
				回到警备队的决定吗？{wait}
			}
			TextWait
			TextTalk name[8] {
				#10103F……不、没有这回事。{wait}
			} {
				#10108F只是，支援课明明也很忙碌却只有我一个人离开，
				我觉得有点不忍心……{wait}
			}
			TextWait
			TextTalk name[0] {
				#00003F诺艾儿……{wait}
			}
			TextWait
			TextTalk char[2] {
				#02003F……为了重建警备队，
				我非常需要你的力量，不过……{wait}
			} {
				#02000F你要放弃回到警备队吗？{wait}
			}
			TextWait
			TextTalk name[8] {
				#10103F不……
				毕竟是我自己决定的事。{wait}
			} {
				#10101F诺艾儿丄希卡，
				本日任务结束后，
				就会回到警备队！{wait}
			}
			TextWait
			TextTalk char[2] {
				#02004F很好。{wait}
			} {
				#02000F不过，现在的你当然还是
				调派到支援课的身份。{wait}
			} {
				别让自己留下遗憾，把剩下的工作
				全部处理完毕再回来。
				……没问题吧？{wait}
			}
			TextWait
			TextTalk name[8] {
				#10100F是！我了解了！{wait}
			}
			TextWait
			FlagSet flag[2]
		else:
			TextTalk char[2] {
				#02000F为了重建警备队，
				我非常需要你的力量。{wait}
			} {
				#02004F别让自己留下遗憾，你今天
				一整天先把支援课的任务
				处理完毕之后再回来警备队。{wait}
