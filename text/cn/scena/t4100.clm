	if flag[3090] && !flag[3093] && QuestFlagsGet quest[137] 0x10 && !QuestFlagsGet quest[149] 0x10:
		LookPointFlagsSet look_point[1] 0x0001
	Return

fn[4]:
	TextStart self
	if flag[3385]:
		if !flag[1]:
			TextTalk self {
				刚才警察有来找我做笔录。{wait}
			}
			TextWait
			TextTalk self {
				没想到伊安居然会做出这种事……
				我完全无法相信。{wait}
			}
			TextWait
			TextTalk name[0] {
				#00001F……嗯，我们也是这么想的。{wait}
			} {
				#00003F（……但是，这就是事实。
				　他的意图只能通过讯问
				　才能了解吧……）{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				没想到伊安居然会
				做出这种事……
				我完全无法相信。{wait}
			}
			TextWait
			TextTalk self {
				究竟是什么原因
				让他这么做……？{wait}
			}
			TextWait
	elif flag[3371]:
		if !flag[3692]:
			TextTalk self {
				我才想说那个屏障终于消失，
				接着马上就
				发生不得了的事。{wait}
			}
			TextWait
			TextTalk self {
				自从那个独立宣言以来，
				来扫墓的人也变少了。{wait}
			}
			TextWait
			TextTalk self {
				在这种情况下，
				我能做的也只有打扫坟墓而已。{wait}
			}
			TextWait
			if QuestFlagsGet quest[149] 0x10:
				Emote name[0] 0mm 2000mm 24 27 250ms 0
				Sleep 1500ms
				EmoteStop name[65278]
				TextTalk name[0] {
					#00003F……请问，{wait}
				} {
					#00008F这边的坟墓
					究竟是谁的呢？{wait}
				}
				TextWait
				Emote self 0mm 2000mm 38 38 250ms 1
				Sleep 1000ms
				TextTalk self {
					什么？原来你不知道啊？{wait}
				}
				TextWait
				TextTalk self {
					……嗯，如果是你们的话，
					说出来也没问题吧。
					毕竟你们似乎也跟『他』很亲近。{wait}
				}
				TextWait
				TextTalk name[1] {
					#00105F咦……？{wait}
				}
				TextWait
				TextTalk name[3] {
					#00305F是我们认识的人吗？{wait}
				}
				TextWait
				TextTalk self {
					……嗯。{wait}
				}
				TextWait
				TextTalk self {
					长眠在这里的人们，
					姓氏是『格林伍德』……{wait}
				}
				TextWait
				TextTalk self {
					也就是
					伊安丄格林伍德的家人。{wait}
				}
				TextWait
				Emote field_party[0] 0mm 2000mm 2 7 80ms 1
				SoundPlay sound[28] 0 100 0
				Sleep 30ms
				Emote field_party[1] 0mm 2000mm 2 7 80ms 1
				SoundPlay sound[28] 0 100 0
				Sleep 30ms
				Emote field_party[2] 0mm 2000mm 2 7 80ms 1
				SoundPlay sound[28] 0 100 0
				Sleep 30ms
				Emote field_party[3] 0mm 2000mm 2 7 80ms 1
				SoundPlay sound[28] 0 100 0
				Sleep 1000ms
				TextTalk name[2] {
					#00205F伊安律师的家人……！？{wait}
				}
				TextWait
				TextTalk name[1] {
					#00108F是、是这样吗……！？{wait}
				}
				TextWait
				TextTalk self {
					……肯定不会错。{wait}
				}
				TextWait
				TextTalk self {
					大约在十五年前，
					因为一场不幸的意外，
					他的妻子跟孩子两人丧生……{wait}
				}
				TextWait
				TextTalk self {
					他总是会在周末来扫墓，
					缅怀家人。{wait}
				}
				TextWait
				TextTalk self {
					虽然坟墓遭到风雨损伤……
					不过他似乎许下了某个心愿。{wait}
				}
				TextWait
				TextTalk self {
					在心愿实现之前，他刻意不进行修缮，
					只拜托我维护而已。{wait}
				}
				TextWait
				TextTalk name[1] {
					#00106F原来是这样啊……{wait}
				}
				TextWait
				TextTalk name[3] {
					#00308F那位律师似乎经历了许多事呢……{wait}
				}
				TextWait
				TextTalk self {
					在独立宣言之后，他似乎也很忙碌，
					所以很难抽空过来……{wait}
				}
				TextWait
				TextTalk self {
					不介意的话，
					之后你们也来扫墓吧。
					……不然她们也会很寂寞吧。{wait}
				}
				TextWait
				TextTalk name[0] {
					#00003F…………{wait}
				} {
					#00000F……好的，我明白了。{wait}
				}
				TextWait
				FlagSet flag[3692]
		else:
			TextTalk self {
				在这种情况下，
				我能做的也只有打扫坟墓而已。{wait}
			}
			TextWait
			TextTalk self {
				……你们也要小心点喔。{wait}
			}
			TextWait
	elif flag[3089]:
	elif flag[2829]:
		if !flag[1]:
			TextTalk self {
				刚才伊安有过来教堂。{wait}
			}
			TextWait
			TextTalk self {
				看来是来为盖跟
				亚里欧斯的妻子扫墓的样子。{wait}
			}
			TextWait
			Emote self 0mm 2000mm 24 27 250ms 0
			Sleep 1000ms
			EmoteStop self
			TextTalk name[0] {
				#00005F呃……怎么了吗？{wait}
			}
			TextWait
			TextTalk self {
				……不，没什么。
				没什么大不了的。{wait}
			}
			TextWait
			TextTalk self {
				他最近似乎很忙，
				要是能散散心的话就好了。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				刚才，
				伊安有来扫盖跟
				亚里欧斯的妻子坟墓。{wait}
			}
			TextWait
			TextTalk self {
				他最近似乎很忙，
				要是能散散心的话就好了。{wait}
			}
			TextWait
	elif flag[2816]:
		if !flag[1]:
			TextTalk self {
				如同市长所说，
				克洛斯贝尔或许真的
				需要成为独立的国家。{wait}
			}
			TextWait
			TextTalk self {
				帝国跟共和国想必也会
				出手施压吧，不过……{wait}
			}
			TextWait
			TextTalk self {
				为了接下来的年轻世代，
				无论如何都希望他成功呢。{wait}
			}
			TextWait
			FlagSet flag[1]
		else:
			TextTalk self {
				克洛斯贝尔或许真的
				需要成为独立的国家。{wait}
			}
			TextWait
			TextTalk self {
				为了接下来的年轻世代，
				无论如何都希望他成功呢。{wait}
			}
