fn[3]:
	if flag[2848] && !flag[2858] | flag[2369] && system[4] == 1:
		EffLoad eff[9] "map/mprain00.eff"
		EffPlay eff[9] eff_instance[7] null 0 (0, 0, 0) 0 0 0 1000 1000 1000 null (0, 0, 0) 1000ms
		MapColor 0x00B4B4B4 0ms
		Fog 0xFFD5B47B 0 360 0
		SoundPlay sound[128] 1 100 0
	if flag[3100]:
		MapColor 0x00FFEBDC 0ms
	else:
	if flag[2831] && !flag[2832]:
		MapColor 0x00B4BEFF 0ms
		Fog 0xFFA0B4DC 20 400 0
	elif flag[2367] && !flag[2369]:
		MapColor 0x00B4BEFF 0ms
		Fog 0xFFA0B4DC 20 400 0
	if !flag[2573] && flag[2564]:
		LookPointFlagsSet look_point[4] 0x0001
	SoundPlayContinuously sound[132] (-10120, 4000, 57000) 10000 100000 100 0
	ED7_E1 (1730, 4000, 57000)
	ED7_E1 (20320, 4000, 57000)
	TriggerFlagsSet trigger[0] 0x0080
	if !flag[2816] && flag[2573] && !flag[2649]:
		TriggerFlagsUnset trigger[0] 0x0080
