fn[28]:
	FadeOut 300ms 0x00000000 100
	FadeWait
	TextSetPos -1 30 -1 -1
	TextSetName ""
	Menu menu[0] -1 -1 0
		"陪尼尔森分析事件" // 0
		"再考虑一下" // 1
	MenuWait var[0]
	MenuClose menu[0]
	TextClose 0
	TextSetPos -1 280 60 3
	FadeIn 300ms 0x00000000
	FadeWait
	switch var[0]:
		case 0:
			TextTalk name[0] {
				#00003F…………{wait}
			} {
				#00001F我知道了。
				请务必让我一起分析。{wait}
			}
			TextWait
			TextTalk char[6] {
				谢谢你们。{wait}
			}
			TextWait
			TextTalk char[6] {
				在这里不太方便，
				总之先回到城镇里吧。{wait}
			}
			TextWait
			FadeOut 300ms 0x00000000 100
			SoundPlay sound[80] 0 100 0
			TextSetPos -1 -1 -1 -1
			TextSetName ""
			TextMessage null {
				开始进行{color 2}委托【盖丄班宁斯遇害事件的分析】{color 0}！{wait}
			}
			TextWait
			TextClose 0
			FadeIn 300ms 0x00000000
			FadeWait
			_59
			TextSetPos -1 280 60 3
			QuestFlagsSet quest[149] 0x02
			ED7_12 132 1000 50
			FadeOut 1000ms 0x00000000 255
			FadeWait
			BgmStop 4000ms
			BgmWait
			FlagSet flag[272]
			NewScene "scena/c0570.bin" 0 0 0
			Hcf
			break
		case 1:
			TextTalk name[0] {
				#00003F……不好意思。
				可以让我考虑一下吗？{wait}
			}
			TextWait
			TextTalk char[6] {
				嗯，没问题。{wait}
			}
			TextWait
			TextTalk char[6] {
				我暂时会待在这里，
				你准备好再来找我。{wait}
			}
			TextWait
			if !flag[9]:
				CharTurnTo char[6] 0deg 500deg/s
				_Char4B char[6] 255
				EventEnd 5
			FlagSet flag[3294]
			break
	Return

